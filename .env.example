# ---------------------------------------------------------------
# Apuestas Intel CO — variables de entorno (copiar a .env)
# Ninguna clave es obligatoria para arrancar: los módulos sin clave
# se desactivan y la interfaz lo indica. Nunca se inventan datos.
# ---------------------------------------------------------------

ENVIRONMENT=production
# En Docker Compose se sobrescribe automáticamente. Para desarrollo local se usa SQLite.
DATABASE_URL=postgresql+psycopg://apuestas:apuestas@localhost:5432/apuestas
POSTGRES_PASSWORD=apuestas
REDIS_URL=redis://localhost:6379/0

# Seguridad (cámbielo: cadena aleatoria larga)
JWT_SECRET=cambie-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:3000
PUBLIC_URL=http://localhost:3000
MIN_AGE=18

# --- Cuotas de operadores colombianos (proveedor con licencia) ---
# https://odds-api.net — cubre los 14 operadores del listado vigente de Coljuegos.
ODDS_API_NET_KEY=
ODDS_API_NET_BASE_URL=https://api.odds-api.net/v1

# https://oddspapi.io — plan GRATUITO (250 peticiones/mes, sin tarjeta): BetPlay y Rushbet Colombia.
ODDSPAPI_KEY=
ODDSPAPI_MIN_HOURS=8

# --- Alertas push al teléfono (app gratuita ntfy: https://ntfy.sh) ---
# Elija un nombre de tema difícil de adivinar y suscríbase a él en la app ntfy.
NTFY_TOPIC=

# --- Referencia internacional opcional (no colombiana) ---
# https://the-odds-api.com — solo referencia de mercado, nunca para recomendar.
THE_ODDS_API_KEY=

# --- Estadísticas, directo, alineaciones y Liga BetPlay ---
# https://www.api-football.com (api-sports.io). Plan gratuito: 100 peticiones/día.
API_FOOTBALL_KEY=
# Baloncesto (misma cuenta api-sports; si se deja vacío usa API_FOOTBALL_KEY)
API_BASKETBALL_KEY=

# --- Asistente conversacional (opcional) ---
# Sin clave, el asistente usa un enrutador de intenciones local.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5

# --- Histórico de entrenamiento (football-data.co.uk, gratuito) ---
FOOTBALL_DATA_LEAGUES=E0,E1,E2,E3,EC,SP1,SP2,I1,I2,D1,D2,F1,F2,N1,P1,B1,T1,G1,SC0,SC1,SC2
FOOTBALL_DATA_EXTRA_LEAGUES=ARG,BRA,MEX,USA,CHN,JPN
FOOTBALL_DATA_SEASONS=2223,2324,2425,2526,2627

# --- Motor ---
ODDS_STALE_AFTER_SECONDS=900
LIVE_ODDS_STALE_AFTER_SECONDS=60
LIVE_POLL_SECONDS=30
PREMATCH_POLL_SECONDS=600
TIMEZONE=America/Bogota

# --- Frontend ---
# URL del WebSocket de directo (por defecto ws://<host>:8000/ws/live)
NEXT_PUBLIC_WS_URL=
